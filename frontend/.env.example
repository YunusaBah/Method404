# Public backend API URL used by the browser.
# Do not put database URLs, passwords, API keys, or other secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:5000/api

# Public browser key only; never use SUPABASE_SECRET_KEY here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to true to use made-up plans without the backend (labelled MOCK DATA).
# Leave unset or false to use real NASA data through the backend.
VITE_USE_MOCK=false
